# Gemini API (get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail read-only OAuth
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=is:unread in:inbox
GMAIL_MAX_RESULTS=25

# Telegram notifications (disabled by default)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ONLY_IMPORTANT=true

# Polling and local storage
POLL_INTERVAL_SECONDS=300
DATABASE_PATH=data/mailmind.sqlite3
LOG_LEVEL=INFO
